KANBAN_API_IMAGE=ghcr.io/owner/repo-api:latest
KANBAN_MCP_IMAGE=ghcr.io/owner/repo-mcp:latest
KANBAN_API_HTTP_PORT=8080

ConnectionStrings__Kanban=Server=127.0.0.1;Port=3306;Database=kanban;User ID=kanban;Password=replace-with-mariadb-password;
Database__CommandTimeoutSeconds=30

Auth__Enabled=true
Auth__Authority=https://identity.trefry.net/realms/YOUR_REALM
Auth__ClientId=kanban-board
Auth__ClientSecret=replace-with-keycloak-client-secret
Auth__RequireHttpsMetadata=true
# OIDC subjects (Keycloak user IDs) of the admins, comma-separated. Empty: no admin page for anyone.
Auth__AdminSubjects=

PersonalAccessTokens__Enabled=true
PersonalAccessTokens__EncryptionKey=replace-with-32-byte-base64-or-64-hex-key
PersonalAccessTokens__TokenPrefix=kbp

InternalApi__SharedSecret=replace-with-random-32-plus-character-internal-secret
McpAuthentication__RequirePersonalAccessToken=true
McpAuthentication__ValidationCacheSeconds=30

# The address people open the board at. Work items in API and MCP answers carry url = {this}/stories/{id};
# empty: url is null.
App__PublicBaseUrl=https://kanban.example.com
